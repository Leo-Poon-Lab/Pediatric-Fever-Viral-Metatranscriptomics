checkpoint viral_blastn:
    input:
        v_r1 = join(reads_taxa_kranken2_dir, "{sample}/viral_1.fa"),
        v_r2 = join(reads_taxa_kranken2_dir, "{sample}/viral_2.fa"),
    output:
        combined_v = join(reads_taxa_kranken2_dir, "{sample}/viral_pairs.fa"),
        matches = join(reads_taxa_kranken2_dir, "{sample}/blastn/matches.tsv")
    threads: 10
    params:
        database = "/home/ubuntu/Tools/Blast/database/NT/nt/nt",
        task = "blastn",
        evalue = 1e-10,
        matches_dir = join(reads_taxa_kranken2_dir, "{sample}/blastn")
    conda: "base"
    shell:
        """
        #check if the contigs are empty
        if [ ! -s {input.v_r1} ]; then
            touch {output.matches}
        else
            cat {input.v_r1} {input.v_r1} > {output.combined_v}
            blastn -query {output.combined_v} -db {params.database} -task {params.task} -outfmt "\
            6 qseqid qlen sseqid slen pident nident ppos positive length qcovs qcovhsp \
            qcovus mismatch gapopen qstart qend sstart send gaps evalue bitscore sstrand \
            staxid stitle" -max_target_seqs 1 \
            -evalue {params.evalue} -num_threads {threads} -out {output.matches}

            # Add header
            echo -e "Query_ID\tQuery_Length\tSubject_ID\tSubject_Length\tPercentage_Identity\tNum_Identical_Matches\tPercentage_Positive\tNum_Positive_Matches\tAlignment_Length\tQuery_Coverage_Percent\tQuery_Coverage_Percent_HSP\tQuery_Coverage_Percent_Unified\tNum_Mismatches\tNum_Gap_Openings\tQuery_Start\tQuery_End\tSubject_Start\tSubject_End\tNum_Gaps\tE_value\tBit_Score\tSubject_Strand\tSubject_Taxonomy_ID\tSubject_Title" > {params.matches_dir}/header
            cat {params.matches_dir}/header {output.matches} > {params.matches_dir}/matches_h.tsv
        
        fi
        """

